# Only the code goes to GitHub: everything at the top level is ignored except these.
/*
!/.gitignore
!/.github/
!/README.md
!/08_Backend/
!/09_Frontend/

# Never commit secrets, installs, uploads, logs, backups
.env
.env.*
!.env.example
venv/
.venv/
node_modules/
build/
__pycache__/
*.pyc
media/
static/
logs/*.log
backups/
db.sqlite3
.idea/
.vscode/
.DS_Store
